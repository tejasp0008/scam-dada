# ---- App ----
APP_ENV=dev
LOG_LEVEL=INFO

# ---- Datastores (match docker-compose.yml) ----
DATABASE_URL=postgresql+asyncpg://dadi:dadi@localhost:5432/scamdadi
REDIS_URL=redis://localhost:6379/0

# ---- Provider selection: gnani | openai | mock ----
STT_PROVIDER=mock
TTS_PROVIDER=mock
LLM_PROVIDER=mock

# ---- Gnani (https://app.gnani.ai/voice) ----
# One key serves both Prisma and Timbre, sent as the X-API-Key-ID header.
GNANI_API_KEY=
GNANI_STT_WS_URL=wss://api.vachana.ai/stt/v3/stream
GNANI_STT_REST_URL=https://api.vachana.ai/stt/v3
GNANI_TTS_SSE_URL=https://api.vachana.ai/api/v1/tts/sse
GNANI_TTS_WS_URL=wss://api.vachana.ai/api/v1/tts
GNANI_TTS_REST_URL=https://api.vachana.ai/api/v1/tts/inference

# Prisma: v3.0 is required for indic-auto and keyterms.
STT_MODEL=prisma-v3.0
STT_LANGUAGE_CODE=indic-auto
STT_SAMPLE_RATE=16000
# transliterate returns Latin-script Hinglish; the other formats return Devanagari
# and dropped words on our test clip. See docs/DECISIONS.md 0009.
STT_FORMAT=transliterate

# Timbre: v3.0 is required for inline audio tags; v2.5 strips them silently.
TTS_MODEL=timbre-v3.0
TTS_LANGUAGE=hi-en

# ---- Personas ----
# Chosen by ear from `make audition-male`, not from a published age attribute: Gnani does
# not publish one. Leave empty until someone has listened. The ageing preset that goes with
# the elder voice lives in app/core/personas.py, because it is part of the character.
PERSONA_ELDER_VOICE=
PERSONA_GRANDSON_VOICE=

# ---- LLM (OpenAI-compatible; Evon is not on Gnani's API platform) ----
# Dialogue needs first tokens fast; analysis can afford to think. Measured values
# behind this split are in docs/DECISIONS.md 0010.
LLM_BASE_URL=https://api.groq.com/openai/v1
LLM_API_KEY=
LLM_MODEL=qwen/qwen3.8-27b
LLM_ANALYSIS_MODEL=openai/gpt-oss-120b
# qwen3.8-27b is a Groq preview model; this is what we switch to if it fails.
LLM_FALLBACK_MODEL=openai/gpt-oss-120b
# The dialogue model needs this too, not just the fallback: without it a
# reasoning model returns empty content on a dense persona prompt.
LLM_REASONING_EFFORT=none
LLM_FALLBACK_REASONING_EFFORT=low
LLM_FIRST_TOKEN_TIMEOUT_S=3.0

# ---- Budget ----
# Gnani programme credits are denominated in rupees (1 credit = Rs 1). The hard stop
# sits short of the balance so there is always credit left to re-record the demo.
BUDGET_ENABLED=true
GNANI_CREDIT_TOTAL=5000
GNANI_CREDIT_STOP_AT=4500
# Raw-unit ceilings: a second line of defence, and the only usable ceiling for the
# LLM pool while its rate is unknown.
BUDGET_MAX_TTS_CHARS=200000
BUDGET_MAX_STT_SECONDS=7200
BUDGET_MAX_LLM_TOKENS=2000000

# ---- Rates ----
# PLACEHOLDERS inferred from a six-request sample on the usage dashboard. Until
# RATES_CONFIRMED=true, every credit figure is flagged as an estimate.
RATES_CONFIRMED=false
STT_RATE_PER_MINUTE=0.45
STT_BILLING_INCREMENT_MINUTES=0.05
STT_MINIMUM_BILLED_MINUTES=0.05
TTS_RATE_PER_1K_CHARS=1.58
LLM_RATE_PER_1M_TOKENS=0
