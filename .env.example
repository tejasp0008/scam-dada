# ---- App ----
APP_ENV=dev
LOG_LEVEL=INFO

# ---- Datastores (match docker-compose.yml) ----
DATABASE_URL=postgresql+asyncpg://dadi:dadi@localhost:5432/scamdadi
REDIS_URL=redis://localhost:6379/0

# ---- Provider selection: gnani | openai | mock ----
STT_PROVIDER=mock
TTS_PROVIDER=mock
LLM_PROVIDER=mock

# ---- Gnani (https://app.gnani.ai/voice) ----
# One key serves both Prisma and Timbre, sent as the X-API-Key-ID header.
GNANI_API_KEY=
GNANI_STT_WS_URL=wss://api.vachana.ai/stt/v3/stream
GNANI_STT_REST_URL=https://api.vachana.ai/stt/v3
GNANI_TTS_SSE_URL=https://api.vachana.ai/api/v1/tts/sse
GNANI_TTS_WS_URL=wss://api.vachana.ai/api/v1/tts
GNANI_TTS_REST_URL=https://api.vachana.ai/api/v1/tts/inference

# Prisma: v3.0 is required for indic-auto and keyterms.
STT_MODEL=prisma-v3.0
STT_LANGUAGE_CODE=indic-auto
STT_SAMPLE_RATE=16000

# Timbre: v3.0 is required for inline audio tags; v2.5 strips them silently.
TTS_MODEL=timbre-v3.0
TTS_LANGUAGE=hi-en

# ---- LLM (OpenAI-compatible; Evon is not on Gnani's API platform) ----
LLM_BASE_URL=
LLM_API_KEY=
LLM_MODEL=
LLM_ANALYSIS_MODEL=

# ---- Budget guard: raw units, since Gnani publishes no credit conversion ----
BUDGET_ENABLED=true
BUDGET_MAX_TTS_CHARS=200000
BUDGET_MAX_STT_SECONDS=7200
BUDGET_MAX_LLM_TOKENS=2000000
